# Project LOOP - Environment Variables Configuration
# Copy to .env for local development

# PostgreSQL Connection (Neon or Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/loop_db?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-random-key-32-chars-minimum-here"

# Anthropic Claude API (Used for Classification, Summarization, and Grounded Q&A)
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key-here"

# Optional Hosted Embeddings or OpenAI Fallback
EMBEDDINGS_API_KEY=""

# Application Environment
NODE_ENV="development"
